# Copy to .env locally; NEVER upload real secrets or keys.
RUN_MODE=paper
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT
TIMEFRAME=5m
STARTING_EQUITY=1000
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.05
MAX_CONSECUTIVE_LOSSES=5
MAX_POSITIONS=3
MAX_LEVERAGE=5
MAX_MARGIN_FRACTION=0.25
MAX_SPREAD_BPS=12
MIN_SCORE=5
COOLDOWN_MINUTES=15
LOOP_SECONDS=20
FEE_RATE=0.0005
SLIPPAGE_BPS=3
DATA_DIR=data
# Optional TESTNET only; production REAL trading is intentionally NOT enabled.
BINANCE_API_KEY=
BINANCE_API_SECRET=
