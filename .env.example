# Copy to .env locally; NEVER upload real secrets or keys.
RUN_MODE=paper
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT
TIMEFRAME=5m
STARTING_EQUITY=1000
RISK_PER_TRADE=0.10
MAX_DAILY_LOSS=0.50
MAX_POSITIONS=3
MAX_LEVERAGE=5
MAX_MARGIN_FRACTION=0.25
MAX_SPREAD_BPS=12
MIN_SCORE=5
# true: >=2 votes (default); false: allow 1 strong vote with extra confirmation
STRICT_VOTES=true
MIN_STRONG_SCORE=7
TRAILING_ATR_MULT=1.0
COOLDOWN_MINUTES=15
LOOP_SECONDS=20
FEE_RATE=0.0005
SLIPPAGE_BPS=3
DATA_DIR=data
# Signed TESTNET only: use VORTEX_TESTNET_* below; production keys are not accepted.

# Optional broad radar across liquid USDT perpetuals (incompatible with fixed WS universe)
USE_RADAR=true
# Optional live microstructure scanning (market depth and trade flow)
USE_MICROSTRUCTURE=false
# Optional public WebSocket quote freshness enforcement
USE_WEBSOCKET=false
# TESTNET credentials only: do NOT put these on GitHub
VORTEX_TESTNET_KEY=
VORTEX_TESTNET_SECRET=
# Optional Telegram notifications (disable when blank)
VORTEX_TELEGRAM_TOKEN=
VORTEX_TELEGRAM_CHAT_ID=

# Requires genuinely trained and validated data/ai_model.json; off by default
USE_AI_MODEL=false
# Optional Claude signal veto, cannot trade or modify risk limits
USE_CLAUDE=false
# Set ONLY if you supply your own secret locally; never push it to GitHub
ANTHROPIC_API_KEY=
VORTEX_CLAUDE_MODEL=claude-sonnet-4-5
# Allow TESTNET-only armed commissioning (set manually, never in a public repo)
# VORTEX_TESTNET_ARM=TESTNET_ONLY

# Phase 1 research strategy; false selects frozen legacy behavior.
PHASE1_ENABLED=true
PHASE1_SESSION_FILTER=true
PHASE1_SESSIONS=asia,london,new_york
PHASE1_ASIA_START=0
PHASE1_ASIA_END=8
PHASE1_LONDON_START=7
PHASE1_LONDON_END=16
PHASE1_NEW_YORK_START=13
PHASE1_NEW_YORK_END=22
PHASE1_VOLATILITY_FILTER=true
PHASE1_ATR_LOOKBACK=100
PHASE1_ATR_PERCENTILE_MIN=40.0
PHASE1_ATR_PCT_MIN=0.0008
PHASE1_ATR_PCT_MAX=0.045
PHASE1_CVD_FILTER=true
PHASE1_CVD_WINDOW=10
PHASE1_CVD_MIN=0.05
PHASE1_RANGE_ADX=20.0
PHASE1_TREND_ADX=25.0
PHASE1_BREAKOUT_ADX=18.0
PHASE1_BREAKOUT_VOLUME=2.0
PHASE1_BREAKOUT_LOOKBACK=20
PHASE1_TREND_WEIGHT=2.0
PHASE1_BREAKOUT_WEIGHT=2.0
PHASE1_REVERSION_WEIGHT=1.0
PHASE1_FUNDING_WEIGHT=1.0
PHASE1_TREND_BOOST=1.0
PHASE1_NORMAL_VOTES=2
PHASE1_NORMAL_WEIGHT=4.0
PHASE1_STRONG_ENABLED=true
PHASE1_STRONG_ADX=30.0
PHASE1_STRONG_VOLUME=3.0
PHASE1_STRONG_BODY_ATR=0.6
PHASE1_STRONG_WEIGHT=3.0
PHASE1_FUNDING_EXTREME=0.0015
PHASE1_FUNDING_OI_MIN_PCT=0.25
PHASE1_FUNDING_PRICE_MIN_PCT=0.1
PHASE1_FUNDING_MAX_AGE_MS=15000
PHASE1_FUNDING_INTERVAL_MIN_MS=60000
PHASE1_FUNDING_INTERVAL_MAX_MS=1800000
PHASE1_MAX_SIGNAL_AGE_MS=90000
