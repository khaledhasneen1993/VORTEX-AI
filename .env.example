# VORTEX-AI 0.2.0: current PAPER release. Use a fresh state directory.
# All features below are current; tokens remain optional and must never be committed.
RUN_MODE=paper
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT
TIMEFRAME=5m
STARTING_EQUITY=1000
RISK_PER_TRADE=0.12
MAX_DAILY_LOSS=0.55
MAX_POSITIONS=4
MAX_LEVERAGE=5
MAX_MARGIN_FRACTION=0.25
MAX_SPREAD_BPS=12
MIN_SCORE=5
MIN_STRONG_SCORE=7
TRAILING_ATR_MULT=0.8
COOLDOWN_MINUTES=15
LOOP_SECONDS=20
FEE_RATE=0.0005
SLIPPAGE_BPS=3
DATA_DIR=data/vortex-020

# Measurement only; current strategy/risk behavior stays unchanged.
VORTEX_SIGNAL_AUDIT=false
# Opt-in larger historical downloads; potentially substantial RAM on Termux.
VORTEX_EXTENDED_HISTORY=false

USE_RADAR=true
USE_MICROSTRUCTURE=false
USE_WEBSOCKET=false
VORTEX_TESTNET_KEY=
VORTEX_TESTNET_SECRET=
VORTEX_TELEGRAM_TOKEN=
VORTEX_TELEGRAM_CHAT_ID=

USE_AI_MODEL=false
USE_CLAUDE=false
ANTHROPIC_API_KEY=
VORTEX_CLAUDE_MODEL=claude-sonnet-4-5

PHASE1_ENABLED=true
PHASE1_SESSION_FILTER=true
PHASE1_SESSIONS=asia,london,new_york
PHASE1_ASIA_START=0
PHASE1_ASIA_END=8
PHASE1_LONDON_START=7
PHASE1_LONDON_END=16
PHASE1_NEW_YORK_START=13
PHASE1_NEW_YORK_END=22
PHASE1_VOLATILITY_FILTER=true
PHASE1_ATR_LOOKBACK=100
PHASE1_ATR_PERCENTILE_MIN=40.0
PHASE1_ATR_PCT_MIN=0.0008
PHASE1_ATR_PCT_MAX=0.045
PHASE1_CVD_FILTER=true
PHASE1_CVD_WINDOW=10
PHASE1_CVD_MIN=0.05
PHASE1_RANGE_ADX=20.0
PHASE1_TREND_ADX=25.0
PHASE1_BREAKOUT_ADX=18.0
PHASE1_BREAKOUT_VOLUME=2.0
PHASE1_BREAKOUT_LOOKBACK=20
PHASE1_TREND_WEIGHT=2.0
PHASE1_BREAKOUT_WEIGHT=2.0
PHASE1_REVERSION_WEIGHT=1.0
PHASE1_FUNDING_WEIGHT=1.0
PHASE1_TREND_BOOST=1.0
PHASE1_NORMAL_VOTES=2
PHASE1_NORMAL_WEIGHT=4.0
PHASE1_STRONG_ENABLED=true
PHASE1_STRONG_ADX=30.0
PHASE1_STRONG_VOLUME=3.0
PHASE1_STRONG_BODY_ATR=0.6
PHASE1_STRONG_WEIGHT=3.0
PHASE1_FUNDING_EXTREME=0.0015
PHASE1_FUNDING_OI_MIN_PCT=0.25
PHASE1_FUNDING_PRICE_MIN_PCT=0.1
PHASE1_FUNDING_MAX_AGE_MS=15000
PHASE1_FUNDING_INTERVAL_MIN_MS=60000
PHASE1_FUNDING_INTERVAL_MAX_MS=1800000
PHASE1_MAX_SIGNAL_AGE_MS=90000

PHASE2_ENABLED=true
PHASE2_NORMAL_MIN=0.08
PHASE2_NORMAL_MAX=0.1
PHASE2_STRONG_MIN=0.12
PHASE2_STRONG_MAX=0.15
PHASE2_PORTFOLIO_STOP_RISK=0.3
PHASE2_ENTRY_MARGIN_FRACTION=0.0625
PHASE2_COMPOUNDING_FRACTION=0.5
PHASE2_PYRAMIDING=true
PHASE2_PYRAMID_TRIGGER_R=2.0
PHASE2_PYRAMID_SPACING_R=0.5
PHASE2_PYRAMID_MAX_ADDS=1
PHASE2_PYRAMID_SIZE_FRACTION=0.25
PHASE2_PYRAMID_RISK_FRACTION=0.02
PHASE2_PYRAMID_MIN_INTERVAL_MS=300000
PHASE2_CORRELATION_FILTER=true
PHASE2_CORRELATION_LOOKBACK=60
PHASE2_CORRELATION_MAX=0.8

OPS_ENABLED=true
OPS_PROFILE=aggressive
OPS_BREAK_EVEN_R=0.8
OPS_TP1_FRACTION=0.3
OPS_TP2_FRACTION=0.3
OPS_TERMINAL_TARGET=false
OPS_STAGNANT_MINUTES=60
OPS_STAGNANT_R=0.5
OPS_FUNDING_GUARD=true
OPS_FUNDING_WINDOW_SECONDS=300
OPS_FUNDING_RATE_THRESHOLD=0.001
OPS_LIQUIDITY_GUARD=true
OPS_MIN_DEPTH_USDT=10000
OPS_DEPTH_BAND_BPS=20
OPS_MAX_DEPTH_PARTICIPATION=0.02
OPS_MAX_OBSERVATION_AGE_MS=15000
OPS_VOLATILITY_SLIP_FACTOR=0.02
OPS_MAX_SLIPPAGE_BPS=30
OPS_MODELED_LATENCY_MS=500
OPS_COST_MULTIPLIER=1.0
OPS_STREAK_START=2
OPS_STREAK_COOLDOWN_MINUTES=30
OPS_STREAK_MAX_MINUTES=120
OPS_DRAWDOWN_1H=0.12
OPS_DRAWDOWN_2H=0.18
OPS_DAILY_WARNING_FRACTION=0.75
OPS_TELEGRAM_ALERTS=false
OPS_FOCUS_SYMBOL=

# Optional offline historical input; never used by paper/testnet workers.
# Requires verified daily CSV archives plus genuine exchange_info.json filters.
VORTEX_LOCAL_OHLCV_DIR=
# Exclusive UTC midnight, e.g. 2026-10-09; mandatory for local backtests.
VORTEX_LOCAL_END_UTC=
