# Copy to .env locally; NEVER upload real secrets or keys.
RUN_MODE=paper
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT
TIMEFRAME=5m
STARTING_EQUITY=1000
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.05
MAX_CONSECUTIVE_LOSSES=5
MAX_POSITIONS=3
MAX_LEVERAGE=5
MAX_MARGIN_FRACTION=0.25
MAX_SPREAD_BPS=12
MIN_SCORE=5
# true: >=2 votes (default); false: allow 1 strong vote with extra confirmation
STRICT_VOTES=true
MIN_STRONG_SCORE=7
TRAILING_ATR_MULT=1.0
COOLDOWN_MINUTES=15
LOOP_SECONDS=20
FEE_RATE=0.0005
SLIPPAGE_BPS=3
DATA_DIR=data
# Signed TESTNET only: use VORTEX_TESTNET_* below; production keys are not accepted.

# Optional broad radar across liquid USDT perpetuals (incompatible with fixed WS universe)
USE_RADAR=false
# Optional live microstructure scanning (market depth and trade flow)
USE_MICROSTRUCTURE=false
# Optional public WebSocket quote freshness enforcement
USE_WEBSOCKET=false
# TESTNET credentials only: do NOT put these on GitHub
VORTEX_TESTNET_KEY=
VORTEX_TESTNET_SECRET=
# Optional Telegram notifications (disable when blank)
VORTEX_TELEGRAM_TOKEN=
VORTEX_TELEGRAM_CHAT_ID=

# Requires genuinely trained and validated data/ai_model.json; off by default
USE_AI_MODEL=false
# Optional Claude signal veto, cannot trade or modify risk limits
USE_CLAUDE=false
# Set ONLY if you supply your own secret locally; never push it to GitHub
ANTHROPIC_API_KEY=
VORTEX_CLAUDE_MODEL=claude-sonnet-4-5
# Allow TESTNET-only armed commissioning (set manually, never in a public repo)
# VORTEX_TESTNET_ARM=TESTNET_ONLY
