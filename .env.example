# VORTEX-AI: adopted PAPER system, source d54ee34 (2026-10-11).
# These are active defaults, not alternative strategy presets.
# Never change policy on a saved wallet. Migration creates a new DATA_DIR.
# Goal: net profit / TOTAL posted margin; leverage counted once.
RUN_MODE=paper
# New group behavior is OFF by default. For it, use configure --equity 20 --basket.
# Set BOTH BASKET_ENABLED=true and MAX_MARGIN_FRACTION=0.60 in a new DATA_DIR.
# Fixed contract: five 10%-equity margins, 5x; group NET / posted margins target 3%.
# One 5-minute loss decision: two strongest aligned members, each half initial margin.
# Added margins join the target denominator. Explicit --basket holds without 15m expiry.
# Original stops, account floor, portfolio risk and execution guards remain.
BASKET_ENABLED=false
# Zero keeps previous lot-rounding behavior. configure/launcher --basket selects 0.90.
# Reject initial allocations below 90% of requested margin; never round up past 10%.
BASKET_MIN_ENTRY_FILL_RATIO=0
# Off by default; configure/launcher --basket explicitly selects true and 0.05.
# Close at net basket loss of 5% of SESSION starting equity (1 USDT for 20).
# Net includes modeled entry/exit costs; this is a PAPER poll-triggered close request.
BASKET_HOLD_UNTIL_TARGET=false
BASKET_LOSS_STARTING_EQUITY_FRACTION=0
TIMEFRAME=5m
STARTING_EQUITY=20
PAPER_EXP_ENABLED=true
PAPER_EXP_CAPTURE_ENABLED=true
PAPER_EXP_AVERAGE_ENABLED=true
PAPER_EXP_PROFIT_MARGIN=0.04
PAPER_EXP_STOP_PRICE=0.10
PAPER_EXP_ACCOUNT_LOSS=0.25
PAPER_EXP_AVERAGE_TRIGGER=0.05
PAPER_EXP_AVERAGE_FRACTION=0.50
OPS_PROFILE=aggressive
RISK_PER_TRADE=0.12
MAX_DAILY_LOSS=0.25
MAX_POSITIONS=5
MAX_LEVERAGE=5
# Legacy total margin: 25%. Basket launcher explicitly sets 0.60, based on group-start equity.
MAX_MARGIN_FRACTION=0.25
COOLDOWN_MINUTES=5
STRICT_VOTES=false
ALLOW_SINGLE_STRONG_VOTE=true
MIN_STRONG_SCORE=6
MIN_SCORE=5
PHASE2_AGGRESSIVE_STRONG_RISK=true
PHASE2_STRONG_MAX=0.18
OPS_SHORT_LOSS_COOLDOWN=true
RADAR_LIMIT=30
RADAR_FAST_RANKING=true
LOOP_SECONDS=10
PHASE1_REGIME_ENABLED=false
PHASE1_FLOW_ENABLED=true
PHASE1_FLOW_MODE=voter
PHASE1_VOLUME_SPIKE_ENABLED=true
PHASE1_LIQUIDITY_SWEEP_ENABLED=false
PHASE1_FUNDING_FLOW_CONFIRM=false
PHASE1_SESSION_FILTER=false
PAPER_FAST_SCAN=true
PAPER_SCAN_WORKERS=4
LIVE_RESILIENCE=true
HEALTH_ENABLED=true
RECORDER_ENABLED=true
RECORDER_DECISIONS=true
RECORDER_INTERVAL_SECONDS=60
RECORDER_FLOW=true
RECORDER_SHUTDOWN_SECONDS=15
USE_RADAR=true
USE_WEBSOCKET=false
USE_AI_MODEL=false
USE_CLAUDE=false
USE_MICROSTRUCTURE=false
OPS_FOCUS_SYMBOL=
OPS_TELEGRAM_ALERTS=false
DATA_DIR=data/vortex-approved

# Modeled budgets; actual sizes remain constrained by all execution caps.
PHASE2_NORMAL_MIN=0.08
PHASE2_NORMAL_MAX=0.10
PHASE2_STRONG_MIN=0.12
# Legacy entry ceiling. Basket fixed 10% allocation replaces it only in basket sizing.
PHASE2_ENTRY_MARGIN_FRACTION=0.0625
PHASE2_PORTFOLIO_STOP_RISK=0.30
PHASE2_COMPOUNDING_FRACTION=0.50
PHASE2_CORRELATION_FILTER=true
OPS_FUNDING_GUARD=true
OPS_LIQUIDITY_GUARD=true
OPS_DRAWDOWN_1H=0.12
OPS_DRAWDOWN_2H=0.18
FEE_RATE=0.0005
SLIPPAGE_BPS=3
# Public candle history; never widen freshness to force opportunities.
PHASE1_MAX_SIGNAL_AGE_MS=90000
PHASE1_ATR_PERCENTILE_MIN=40
PHASE1_ATR_PCT_MIN=0.0008
PHASE1_ATR_PCT_MAX=0.045
# Sampled recorder rotation and bounded queue; no full trade tape.
RECORDER_ROTATE_BYTES=8388608
RECORDER_ROTATE_SECONDS=3600
RECORDER_DEPTH_LEVELS=10
RECORDER_QUEUE_SIZE=64
# Optional Telegram credentials, unused by the adopted launcher. Never commit.
VORTEX_TELEGRAM_TOKEN=
VORTEX_TELEGRAM_CHAT_ID=

# Mandatory adopted components
PHASE1_ENABLED=true
PHASE2_ENABLED=true
OPS_ENABLED=true

# Retained policy metadata from the adopted run; capture exits do not trail.
TRAILING_ATR_MULT=1.0
