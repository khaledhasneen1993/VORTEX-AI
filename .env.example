# VORTEX-AI — current 2–5-position PAPER basket system.
# Migration: python -m vortex.configure --equity 100 (new isolated wallet).
# No API keys, signed orders or live exchange execution.
RUN_MODE=paper
# Default strategy 911. Prefer configure --strategy 913 / bash run_913.sh 3600
# for the separate independent-position preset (up to 15, net +1%/-5% margin).
STRATEGY_913_ENABLED=false
BASKET_ENABLED=true
# Open the strongest 2..5 eligible members; fewer than two means no group.
BASKET_MIN_SIZE=2
# Initial margin is UP TO 10% of group-start equity, reduced to fit risk/cash.
# False restores exact requested margin plus the historical fill-ratio check.
BASKET_ADAPTIVE_ENTRY_SIZE=true
# Used only when adaptive sizing is false; exchange minimums always apply.
BASKET_MIN_ENTRY_FILL_RATIO=0.90
BASKET_HOLD_UNTIL_TARGET=true
# Fixed SESSION starting balance: -10 USDT from 100 requests group close.
BASKET_LOSS_STARTING_EQUITY_FRACTION=0.10
# Fixed NET USDT for the entire group; not per member or a percentage.
BASKET_FIXED_NET_TARGET=0.20
# Re-rank immediately after all selected members close; freshness/cooldowns still apply.
BASKET_RESCAN_AFTER_CLOSE=true
# Historical timed fallback disabled; fixed target always takes precedence.
BASKET_ANY_PROFIT_AFTER_SECONDS=0
# Losing members only, fresh aligned signals, new adverse move, original caps.
BASKET_SMART_ADDS=true
BASKET_SMART_ADD_INTERVAL_SECONDS=300
BASKET_SMART_ADD_MAX_ROUNDS=3
BASKET_SMART_ADD_STEP_ATR=0.5
TIMEFRAME=5m
STARTING_EQUITY=100
PAPER_EXP_ENABLED=true
PAPER_EXP_CAPTURE_ENABLED=true
# Saved-policy compatibility fields below; individual profit/average logic is
# inactive. Actual exits and adds are controlled by BASKET_*.
PAPER_EXP_AVERAGE_ENABLED=true
PAPER_EXP_PROFIT_MARGIN=0.04
PAPER_EXP_STOP_PRICE=0.10
PAPER_EXP_ACCOUNT_LOSS=0.25
PAPER_EXP_AVERAGE_TRIGGER=0.05
PAPER_EXP_AVERAGE_FRACTION=0.50
OPS_PROFILE=aggressive
RISK_PER_TRADE=0.12
MAX_DAILY_LOSS=0.25
MAX_POSITIONS=5
MAX_LEVERAGE=10
# Explicit PAPER-basket-only opt-in. False preserves the original 5x cap.
PAPER_10X_LEVERAGE=true
# Total margin ceiling: 60% of frozen group-start equity, also cash/risk bounded.
MAX_MARGIN_FRACTION=0.60
COOLDOWN_MINUTES=5
STRICT_VOTES=false
ALLOW_SINGLE_STRONG_VOTE=true
MIN_STRONG_SCORE=6
MIN_SCORE=5
PHASE2_AGGRESSIVE_STRONG_RISK=true
PHASE2_STRONG_MAX=0.18
OPS_SHORT_LOSS_COOLDOWN=true
RADAR_LIMIT=30
RADAR_FAST_RANKING=true
LOOP_SECONDS=10
PHASE1_REGIME_ENABLED=false
PHASE1_FLOW_ENABLED=true
PHASE1_FLOW_MODE=voter
PHASE1_VOLUME_SPIKE_ENABLED=true
PHASE1_LIQUIDITY_SWEEP_ENABLED=false
PHASE1_FUNDING_FLOW_CONFIRM=false
PHASE1_SESSION_FILTER=false
PAPER_FAST_SCAN=true
PAPER_SCAN_WORKERS=4
LIVE_RESILIENCE=true
HEALTH_ENABLED=true
RECORDER_ENABLED=true
RECORDER_DECISIONS=true
RECORDER_INTERVAL_SECONDS=60
RECORDER_FLOW=true
RECORDER_SHUTDOWN_SECONDS=15
USE_RADAR=true
USE_WEBSOCKET=false
USE_AI_MODEL=false
USE_CLAUDE=false
USE_MICROSTRUCTURE=false
OPS_FOCUS_SYMBOL=
OPS_TELEGRAM_ALERTS=false
DATA_DIR=data/vortex-approved

# Modeled budgets; actual sizes remain constrained by all execution caps.
PHASE2_NORMAL_MIN=0.08
PHASE2_NORMAL_MAX=0.10
PHASE2_STRONG_MIN=0.12
# Compatibility metadata: fixed basket allocation overrides this per-entry ceiling.
PHASE2_ENTRY_MARGIN_FRACTION=0.0625
PHASE2_PORTFOLIO_STOP_RISK=0.30
PHASE2_COMPOUNDING_FRACTION=0.50
PHASE2_CORRELATION_FILTER=true
OPS_FUNDING_GUARD=true
OPS_LIQUIDITY_GUARD=true
OPS_DRAWDOWN_1H=0.12
OPS_DRAWDOWN_2H=0.18
FEE_RATE=0.0005
SLIPPAGE_BPS=3
# Public candle history; never widen freshness to force opportunities.
PHASE1_MAX_SIGNAL_AGE_MS=90000
PHASE1_ATR_PERCENTILE_MIN=40
PHASE1_ATR_PCT_MIN=0.0008
PHASE1_ATR_PCT_MAX=0.045
# Sampled recorder rotation and bounded queue; no full trade tape.
RECORDER_ROTATE_BYTES=8388608
RECORDER_ROTATE_SECONDS=3600
RECORDER_DEPTH_LEVELS=10
RECORDER_QUEUE_SIZE=64
# Optional Telegram credentials, unused by the adopted launcher. Never commit.
VORTEX_TELEGRAM_TOKEN=
VORTEX_TELEGRAM_CHAT_ID=

# Mandatory adopted components
PHASE1_ENABLED=true
PHASE2_ENABLED=true
OPS_ENABLED=true

# Retained policy metadata from the adopted run; capture exits do not trail.
TRAILING_ATR_MULT=1.0
